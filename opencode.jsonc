{
  "$schema": "https://opencode.ai/config.json",

  // All browser automation in this project runs through the `agent-webbridge`
  // skill, which drives REAL Google Chrome with the user's LIVE logins in the
  // "Testing" profile (Chrome profile dir "Profile 5"). No Playwright MCP here:
  // the fleet is brought up with `awb up "Testing"` (router on 127.0.0.1:10086).
  "skills": {
    "paths": [".opencode/skills"]
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  }
}
