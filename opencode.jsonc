{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "pitch": {
      "type": "remote",
      "url": "https://api.trypitch.co/mcp",
      "headers": {
        "Authorization": "Bearer {env:PITCH_API_KEY}"
      },
      "enabled": true,
      "timeout": 300000
    },
    "xmcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@xdevplatform/xurl",
        "mcp",
        "https://api.x.com/mcp"
      ],
      "environment": {
        "CLIENT_ID": "{env:X_CLIENT_ID}",
        "CLIENT_SECRET": "{env:X_CLIENT_SECRET}"
      },
      "enabled": true,
      "timeout": 300000
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  }
}
