# Live X session — DO NOT COMMIT (contains login cookies)
.browser-profile/

# Playwright MCP run artifacts (page snapshots, console logs — may hold scraped data)
.playwright-mcp/

# Bot CRM/state SHOULD be committed so another server can `git pull` and
# continue the same community-building history.
# Keep: .opencode/skills/x-growth/state/{prospects.jsonl, activity-log.jsonl,
# insights.md, account.json, circuit-breaker.jsonl}

# Runner runtime files are machine-local.
.opencode/skills/x-growth/state/runner.log
.opencode/skills/x-growth/state/runner.pid
.opencode/skills/x-growth/state/STOP
.opencode/skills/x-growth/state/PAUSE
.opencode/skills/x-growth/state/HARD_STOP
.opencode/skills/x-growth/state/session-count
