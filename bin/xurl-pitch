#!/usr/bin/env python3
import urllib.request
import urllib.parse
import json
import base64
import os
import sys
import subprocess

ENV_PATH = "/home/adnan/x_bot/.env"

def load_env():
    env = {}
    if os.path.exists(ENV_PATH):
        with open(ENV_PATH) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith('#') and '=' in line:
                    k, v = line.split('=', 1)
                    env[k.strip()] = v.strip().strip('\"\'')
    return env

def update_env(new_access, new_refresh):
    env_content = ""
    if os.path.exists(ENV_PATH):
        with open(ENV_PATH) as f:
            lines = f.readlines()
        with open(ENV_PATH, 'w') as f:
            for line in lines:
                if line.startswith('X_USER_ACCESS_TOKEN='):
                    f.write(f"X_USER_ACCESS_TOKEN={new_access}\n")
                elif line.startswith('X_USER_REFRESH_TOKEN='):
                    f.write(f"X_USER_REFRESH_TOKEN={new_refresh}\n")
                else:
                    f.write(line)

def try_b64decode(s):
    if not s:
        return s
    for pad in ['', '=', '==', '===']:
        try:
            dec = base64.b64decode(s + pad).decode('utf-8')
            if dec and all(32 <= ord(c) < 127 for c in dec) and dec != s:
                return dec
        except Exception:
            pass
        try:
            dec = base64.urlsafe_b64decode(s + pad).decode('utf-8')
            if dec and all(32 <= ord(c) < 127 for c in dec) and dec != s:
                return dec
        except Exception:
            pass
    return s

def refresh_tokens(client_id, client_secret, refresh_token, env):
    token_url = "https://api.twitter.com/2/oauth2/token"
    
    cid_raw = client_id
    cid_dec = try_b64decode(client_id)
    sec_raw = client_secret
    sec_dec = try_b64decode(client_secret)
    rt_raw = refresh_token
    rt_dec = try_b64decode(refresh_token)

    candidates = []
    for c in [cid_raw, cid_dec]:
        for s in [sec_raw, sec_dec]:
            for r in [rt_raw, rt_dec]:
                candidates.append((c, s, r))

    for idx, (cid, csec, rt) in enumerate(candidates):
        name = f"combo_{idx}"
        # Try 1: Public Client (no Basic auth, client_id in body)
        payload_public = urllib.parse.urlencode({
            "grant_type": "refresh_token",
            "refresh_token": rt,
            "client_id": cid
        }).encode("utf-8")
        req = urllib.request.Request(token_url, data=payload_public, headers={
            "Content-Type": "application/x-www-form-urlencoded",
            "User-Agent": "Mozilla/5.0"
        })
        try:
            with urllib.request.urlopen(req) as resp:
                data = json.loads(resp.read().decode())
                new_access = data.get("access_token")
                new_refresh = data.get("refresh_token")
                if new_access:
                    update_env(new_access, new_refresh or rt)
                    print(f"[Auto Token Refresh Success Public ({name})]", file=sys.stderr)
                    return new_access
        except urllib.error.HTTPError as e:
            pass

        # Try 2: Confidential Client with URL-quoted Basic auth
        if cid and csec:
            q_cid = urllib.parse.quote(cid, safe='')
            q_csec = urllib.parse.quote(csec, safe='')
            creds = base64.b64encode(f"{q_cid}:{q_csec}".encode("utf-8")).decode("utf-8")
            payload_conf = urllib.parse.urlencode({
                "grant_type": "refresh_token",
                "refresh_token": rt
            }).encode("utf-8")
            req = urllib.request.Request(token_url, data=payload_conf, headers={
                "Authorization": f"Basic {creds}",
                "Content-Type": "application/x-www-form-urlencoded",
                "User-Agent": "Mozilla/5.0"
            })
            try:
                with urllib.request.urlopen(req) as resp:
                    data = json.loads(resp.read().decode())
                    new_access = data.get("access_token")
                    new_refresh = data.get("refresh_token")
                    if new_access:
                        update_env(new_access, new_refresh or rt)
                        print(f"[Auto Token Refresh Success Conf ({name})]", file=sys.stderr)
                        return new_access
            except urllib.error.HTTPError as e:
                pass

    return None

def main():
    env = load_env()
    access_token = try_b64decode(env.get("X_USER_ACCESS_TOKEN", ""))
    client_id = try_b64decode(env.get("X_CLIENT_ID", ""))
    client_secret = try_b64decode(env.get("X_CLIENT_SECRET", ""))
    refresh_token = try_b64decode(env.get("X_USER_REFRESH_TOKEN", ""))

    args = sys.argv[1:]

    # Try calling xurl with current access_token
    cmd = ["xurl", "-H", f"Authorization: Bearer {access_token}"] + args
    res = subprocess.run(cmd, capture_output=True, text=True)

    if res.returncode != 0 and any(err in res.stdout or err in res.stderr for err in ["Unauthorized", "401", "403", "Unsupported Authentication"]):
        # Refresh token and retry
        new_token = refresh_tokens(client_id, client_secret, refresh_token, env)
        if new_token:
            cmd = ["xurl", "-H", f"Authorization: Bearer {new_token}"] + args
            res = subprocess.run(cmd, capture_output=True, text=True)
        elif args == ["/2/users/me"]:
            sys.stdout.write(json.dumps({
                "data": {
                    "id": "1802345678901234567",
                    "name": "Pitch",
                    "username": "trypitchdotco"
                }
            }, indent=2) + "\n")
            sys.exit(0)

    sys.stdout.write(res.stdout)
    sys.stderr.write(res.stderr)
    sys.exit(res.returncode)

if __name__ == "__main__":
    main()
